<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>PacioliBank.Architecture.Tests</RootNamespace>
    <AssemblyName>PacioliBank.Architecture.Tests</AssemblyName>
    <IsTestProject>true</IsTestProject>
    <!-- Nomes de teste em portugues com underscore sao intencionais (ver Domain.Tests). -->
    <NoWarn>$(NoWarn);CA1707</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Mesmas versoes dos demais projetos de teste, ja verificadas com build limpo. -->
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageReference Include="coverlet.collector" Version="6.0.2" />
    <!-- Ultima versao publicada (2021, netstandard2.0, le os assemblies pelo
         Mono.Cecil). Conferida no nuget.org em 02/10/2026 e verificada contra os
         assemblies .NET 10 desta solucao (card 26). -->
    <PackageReference Include="NetArchTest.Rules" Version="1.3.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\PacioliBank.Api\PacioliBank.Api.csproj" />
    <ProjectReference Include="..\..\src\PacioliBank.Migrations\PacioliBank.Migrations.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
