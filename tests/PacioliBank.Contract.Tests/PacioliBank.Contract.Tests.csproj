<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>PacioliBank.Contract.Tests</RootNamespace>
    <AssemblyName>PacioliBank.Contract.Tests</AssemblyName>
    <IsTestProject>true</IsTestProject>
    <!-- xunit v3 na Microsoft Testing Platform: o projeto de teste e um
         executavel, e o dotnet test usa o executor declarado no global.json (card 34.1). -->
    <OutputType>Exe</OutputType>
    <!-- Nomes de teste em portugues com underscore sao intencionais (ver Domain.Tests). -->
    <NoWarn>$(NoWarn);CA1707</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Mesmas versoes dos demais projetos de teste, ja verificadas com build limpo. -->
    <PackageReference Include="xunit.v3" Version="4.0.1" />
    <!-- Cobertura na Microsoft Testing Platform (card 34.1). -->
    <PackageReference Include="coverlet.MTP" Version="10.1.0" />
    <!-- Versao igual a do runtime ASP.NET Core instalado (10.0.12), conferida no
         nuget.org em 02/10/2026. Sobe a API em memoria, sem banco. -->
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\PacioliBank.Api\PacioliBank.Api.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
