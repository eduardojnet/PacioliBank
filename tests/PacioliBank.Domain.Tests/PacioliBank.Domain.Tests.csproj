<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>PacioliBank.Domain.Tests</RootNamespace>
    <AssemblyName>PacioliBank.Domain.Tests</AssemblyName>
    <IsTestProject>true</IsTestProject>
    <!-- xunit v3 na Microsoft Testing Platform: o projeto de teste e um
         executavel, e o dotnet test usa o executor declarado no global.json (card 34.1). -->
    <OutputType>Exe</OutputType>
    <!-- Nomes de teste em portugues com underscore sao intencionais: o teste
         descreve a regra de negocio e e lido por quem nao programa. -->
    <NoWarn>$(NoWarn);CA1707</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="4.0.1" />
    <!-- Cobertura na Microsoft Testing Platform (card 34.1). -->
    <PackageReference Include="coverlet.MTP" Version="10.1.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\PacioliBank.Ledger\PacioliBank.Ledger.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
