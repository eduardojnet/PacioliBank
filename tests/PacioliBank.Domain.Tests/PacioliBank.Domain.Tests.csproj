<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>PacioliBank.Domain.Tests</RootNamespace>
    <AssemblyName>PacioliBank.Domain.Tests</AssemblyName>
    <IsTestProject>true</IsTestProject>
    <!-- Nomes de teste em portugues com underscore sao intencionais: o teste
         descreve a regra de negocio e e lido por quem nao programa. -->
    <NoWarn>$(NoWarn);CA1707</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.0" />
    <PackageReference Include="coverlet.collector" Version="10.1.0" />
    <!-- Limite de cobertura da RNF-036 (card 31.2). Mesma versao do coletor.
         So age quando CollectCoverage=true, no passo proprio do CI. -->
    <PackageReference Include="coverlet.msbuild" Version="10.1.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\PacioliBank.Ledger\PacioliBank.Ledger.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
