<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>PacioliBank.Integration.Tests</RootNamespace>
    <AssemblyName>PacioliBank.Integration.Tests</AssemblyName>
    <IsTestProject>true</IsTestProject>
    <!-- xunit v3 na Microsoft Testing Platform: o projeto de teste e um
         executavel, e o dotnet test usa o executor declarado no global.json (card 34.1). -->
    <OutputType>Exe</OutputType>
    <NoWarn>$(NoWarn);CA1707</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Mesmas versoes do projeto de dominio, ja verificadas com build limpo. -->
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.12" />
    <PackageReference Include="OpenTelemetry.Exporter.InMemory" Version="1.19.1" />
    <PackageReference Include="xunit.v3" Version="4.0.1" />
    <!-- Cobertura na Microsoft Testing Platform (card 34.1). -->
    <PackageReference Include="coverlet.MTP" Version="10.1.0" />
    <PackageReference Include="Testcontainers.PostgreSql" Version="4.15.0" />
    <PackageReference Include="Npgsql" Version="10.0.3" />
    <PackageReference Include="Dapper" Version="2.1.89" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\PacioliBank.Ledger\PacioliBank.Ledger.csproj" />
    <ProjectReference Include="..\..\src\PacioliBank.Ledger.Persistence\PacioliBank.Ledger.Persistence.csproj" />
    <ProjectReference Include="..\..\src\PacioliBank.Events\PacioliBank.Events.csproj" />
    <ProjectReference Include="..\..\src\PacioliBank.Migrations\PacioliBank.Migrations.csproj" />
    <ProjectReference Include="..\..\src\PacioliBank.Api\PacioliBank.Api.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
